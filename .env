# Environment Configuration

# --- Service Ports ---
GATEWAY_PORT=5000
REGION_PORT=5001
SIMULATION_PORT=5002
RESOURCE_PORT=5003
FAULT_PORT=5004
EVENT_BUS_PORT=5005
FRONTEND_PORT=3000
VITE_API_BASE=http://localhost:5000/api

# --- Service Timeouts (milliseconds) ---
HTTP_TIMEOUT=5000
LONG_POLL_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=10000
EVENT_BUS_TIMEOUT=5000

# --- Logging ---
LOG_LEVEL=INFO

# --- Simulation Parameters ---
INFECTION_RATE=0.15
RECOVERY_RATE=0.10
MORTALITY_RATE=0.02
MOBILITY_FACTOR=1.0

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=epidemic_user
DB_PASSWORD=epidemic_password
DB_NAME=epidemic_simulation
DB_POOL_SIZE=10
DB_IDLE_TIMEOUT=10000
