# Environment Configuration

# --- Gateway Service ---
GATEWAY_PORT=5000

# --- Region Service ---
REGION_PORT=5001

# --- Simulation Service ---
SIMULATION_PORT=5002

# --- Resource Service ---
RESOURCE_PORT=5003

# --- Fault Service ---
FAULT_PORT=5004

# --- Event Bus Service ---
EVENT_BUS_PORT=5005

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_BASE=/api
REGION_SERVICE_URL=http://region-service:5001
SIMULATION_SERVICE_URL=http://simulation-service:5002
RESOURCE_SERVICE_URL=http://resource-service:5003
FAULT_SERVICE_URL=http://fault-service:5004
EVENT_BUS_SERVICE_URL=http://event-bus:5005

# --- Service Timeouts (milliseconds) ---
HTTP_TIMEOUT=5000
LONG_POLL_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=10000
EVENT_BUS_TIMEOUT=5000

# --- Logging ---
LOG_LEVEL=INFO

# --- Simulation Parameters ---
INFECTION_RATE=0.15
RECOVERY_RATE=0.10
MORTALITY_RATE=0.02
MOBILITY_FACTOR=1.0

# --- Database (for future use) ---
# DATABASE_URL=sqlite:///epidemic.db

# --- Environment ---
NODE_ENV=development
